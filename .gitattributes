# Core FSM library files
core/*.c linguist-detectable=true
core/*.h linguist-detectable=true

# Example projects - make these detectable
examples/even-number-of-ones/*.c linguist-detectable=true
examples/even-number-of-ones/*.h linguist-detectable=true
examples/even-number-of-ones/CMakeLists.txt linguist-detectable=true
examples/even-number-of-ones/build.sh linguist-detectable=true

examples/recognize-strings-ending-with-ab/*.c linguist-detectable=true
examples/recognize-strings-ending-with-ab/*.h linguist-detectable=true
examples/recognize-strings-ending-with-ab/CMakeLists.txt linguist-detectable=true
examples/recognize-strings-ending-with-ab/build.sh linguist-detectable=true

